---
// 고객 후기 카드(PRD 3장). 본문은 파일 원문 그대로. course·date가 비면 그 줄을 뺀다.
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

interface Props {
  review: CollectionEntry<'reviews'>;
}
const { review } = Astro.props;
const { Content } = await render(review);
const { affiliation, role, course, date } = review.data;
const extra = [course, date].filter(Boolean).join(' · ');
---

<li class="review">
  <figure>
    <blockquote><Content /></blockquote>
    <figcaption>
      <span class="who">{affiliation} {role}</span>{' '}
      {extra && <span class="extra">{extra}</span>}
    </figcaption>
  </figure>
</li>

<style>
  .review {
    break-inside: avoid;
    margin-bottom: 14px;
  }
  figure {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 20px 22px;
    display: grid;
    gap: 12px;
  }
  blockquote {
    margin: 0;
    font-size: 16px;
    color: var(--ink);
    position: relative;
  }
  blockquote::before {
    content: '“';
    display: block;
    font-size: 34px;
    line-height: 0.8;
    height: 14px;
    color: var(--accent);
    font-weight: 800;
  }
  blockquote :global(p + p) {
    margin-top: 0.6em;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .who {
    font-weight: 700;
    color: var(--ink-2);
  }
</style>
