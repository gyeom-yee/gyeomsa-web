---
// 주요 교육 기업 글자 워드클라우드(PRD 3장 홈). clients.yaml의 순서와 size만 쓴다.
// 강의 이력의 익명 표기와 연결하지 않는다(PRD F5-4).
import { getClients } from '../lib/content.ts';
const clients = await getClients();
---

{
  clients.length > 0 && (
    <section class="section" aria-labelledby="clients-title">
      <div class="wrap">
        <div class="section-head center">
          <span class="eyebrow">Clients</span>
          <h2 id="clients-title">주요 교육 기업</h2>
        </div>
        <ul class="cloud reveal">
          {clients.map((c) => (
            <li class={`s${c.size}`}>{c.name}</li>
          ))}
        </ul>
        <p class="note">글자 크기는 교육 규모를 나타냅니다</p>
      </div>
    </section>
  )
}

<style>
  .center {
    text-align: center;
    justify-items: center;
  }
  .cloud {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 920px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 22px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  li {
    transition: color 0.2s ease;
  }
  .s1 {
    font-size: clamp(15px, 1.7vw, 18px);
    font-weight: 500;
    /* 배경 대비 4.5:1 이상(접근성 AA) */
    color: var(--muted);
  }
  .s2 {
    font-size: clamp(19px, 2.4vw, 25px);
    font-weight: 600;
    color: #4f5b9a;
  }
  .s3 {
    font-size: clamp(25px, 3.4vw, 36px);
    font-weight: 700;
    color: #3a4db8;
  }
  .s4 {
    font-size: clamp(31px, 4.6vw, 50px);
    font-weight: 800;
    color: var(--accent);
  }
  li:hover {
    color: var(--ink);
  }
  .note {
    margin-top: 28px;
    text-align: center;
    font-size: 14px;
    color: var(--muted);
  }
</style>
