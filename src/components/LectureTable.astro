---
// 강의 이력 표(PRD 3장 /lectures/). 공개기업명·공개과정명이 같은 차수를 한 줄로 묶은 값을 받는다.
import type { LectureGroup } from '../lib/notion/index.ts';
import { formatNumber } from '../lib/content.ts';

interface Props {
  groups: LectureGroup[];
  caption: string;
}
const { groups, caption } = Astro.props;
const period = (g: LectureGroup) => (!g.start ? '' : g.start === g.end ? g.start : `${g.start} ~ ${g.end}`);
---

<div class="table">
  <table>
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">시기</th>
        <th scope="col">기업·기관</th>
        <th scope="col">과정</th>
        <th scope="col">역할</th>
        <th scope="col">횟수·시간</th>
      </tr>
    </thead>
    <tbody>
      {
        groups.map((g) => (
          <tr>
            <td data-label="시기" class="period">{period(g)}</td>
            <td data-label="기업·기관" class="org">{g.org}</td>
            <th scope="row" data-label="과정" class="course">{g.course}</th>
            <td data-label="역할">{g.roles.join(' · ')}</td>
            <td data-label="횟수·시간" class="nums">
              {g.sessions}회 · {formatNumber(g.hours)}시간
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  caption {
    text-align: left;
    padding: 16px 20px;
    font-size: 14px;
    color: var(--muted);
    border-bottom: 1px solid var(--line);
  }
  th,
  td {
    text-align: left;
    padding: 14px 20px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  thead th {
    font-size: 13px;
    font-weight: 700;
    color: var(--muted);
    background: #f8f7f3;
    white-space: nowrap;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  tbody tr:hover {
    background: #faf9f5;
  }
  .course {
    font-weight: 700;
  }
  .period,
  .nums {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
  }
  .org {
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    caption {
      display: block;
    }
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    tr {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 2px 12px;
      padding: 16px 18px;
      border-bottom: 1px solid var(--line);
    }
    tbody tr:last-child {
      border-bottom: 0;
    }
    th,
    td {
      padding: 0;
      border: 0;
    }
    .course {
      grid-column: 1 / -1;
      grid-row: 2;
      font-size: 16px;
    }
    .period {
      grid-row: 1;
      font-size: 13px;
    }
    .org {
      grid-row: 1;
      grid-column: 2;
      text-align: right;
      font-size: 13px;
    }
    td:not(.period):not(.org) {
      font-size: 13px;
      color: var(--muted);
      grid-row: 3;
    }
    td.nums {
      text-align: right;
      grid-column: 2;
    }
  }
</style>
