---
import Base from '../../layouts/Base.astro';
import LectureTable from '../../components/LectureTable.astro';
import ContactCta from '../../components/ContactCta.astro';
import { site } from '../../site.config.ts';
import { getLectureGroups, getLectureStats, ROLE_LABEL } from '../../lib/notion/index.ts';
import { formatNumber } from '../../lib/content.ts';

const groups = await getLectureGroups();
const stats = await getLectureStats();
---

<Base
  title={`강의 이력 | ${site.name}`}
  description={`${site.name}이 기업·기관 ${formatNumber(stats.orgCount)}곳에서 진행한 AI 교육 ${formatNumber(stats.courseCount)}개 과정의 기록. 과정별 시기, 역할, 횟수와 시간을 표로 정리했습니다.`}
  breadcrumb="강의 이력"
>
  <div class="wrap page-head">
    <h1>강의 이력</h1>
    <p class="lead">
      기업·기관 {formatNumber(stats.orgCount)}곳에서 진행한 AI 교육 과정 {formatNumber(stats.courseCount)}개의
      기록입니다. 누적 교육 참여시간은 {formatNumber(stats.totalHours)}시간({ROLE_LABEL.lead}{' '}
      {formatNumber(stats.leadHours)}시간, {ROLE_LABEL.coach} {formatNumber(stats.coachHours)}시간), 누적 수강인원은{' '}
      {formatNumber(stats.totalStudents)}명입니다.
    </p>
    <p class="note">
      완료한 강의만 싣습니다. 같은 기업·기관에서 같은 과정을 여러 차수 진행한 경우 한 줄로 묶었습니다. 기업명은 공개
      범위에 따라 업종과 규모로 표기했습니다.
    </p>
  </div>
  <div class="wrap">
    <LectureTable
      groups={groups}
      caption={`과정 ${formatNumber(stats.courseCount)}개를 기업·기관별로 나눈 ${formatNumber(groups.length)}건 · 최근 순`}
    />
    <p class="programs">
      이 이력을 바탕으로 한 교육 프로그램은 <a href="/#programs">홈의 주요 교육 프로그램</a>에서 볼 수 있습니다.
    </p>
  </div>
  <ContactCta />
</Base>

<style>
  .note {
    font-size: 15px;
    color: var(--muted);
    max-width: 68ch;
  }
  .programs {
    margin-top: 20px;
    color: var(--ink-2);
  }
</style>
