# 비밀값. 저장소에 올리지 않는다
.env
.env.*
!.env.example

# 작명 메모. 저장소에 올리지 않는다
naming/

# 참고용으로 저장한 외부 사이트. 저장소에 올리지 않는다
references/

# raw_로 시작하는 폴더. 저장소에 올리지 않는다
raw_*/

# 의존성
node_modules/

# 빌드 결과와 Astro 생성 파일
dist/
.astro/

# 로그
*.log
npm-debug.log*

# 캐시. Notion 응답 캐시는 기업 실명이 들어 있으므로 반드시 제외
.cache/
.notion-cache/

# 커밋 검사용 비공개 단어 목록
.githooks/denylist.local
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db
desktop.ini

# 에디터
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp

# Claude Code 설정. 저장소에 올리지 않는다
.claude/settings.json
.claude/settings.local.json
